{
    "name": "insane/agreements",
    "description": "Contracts that bill on a cycle (retainers, rents, admissions) on top of insane/journal",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jesus Guerrero",
            "email": "jesusantguerrero@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "insane/journal": "*"
    },
    "autoload": {
        "psr-4": {
            "Insane\\Agreements\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Insane\\Agreements\\AgreementsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
